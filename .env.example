# Конфигурация Copart Parser.
# Этот файл лежит в git. Настоящий .env создаётся руками:
#   cp .env.example .env
# и живёт в .gitignore — секреты сюда не попадают.

# --- Telegram ---
# Один бот и для разработки, и для прода.
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=

# --- MySQL ---
# Локально: mysql / changeme (docker-compose).
# На сервере: mysql84 / <root-пароль mysql84>.
MYSQL_HOST=mysql
MYSQL_DB=copart-parser
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=changeme

# --- Скрейпер ---
BASE_URL="https://www.copart.com"
#PROXY_URL="socks5://127.0.0.1:9150" // 9150 = Tor
# ссылку поиска пишет бот: /seturl
SEARCH_URL=""
TARGET_LOTS=10
CONCURRENCY=10
HEADLESS=false
